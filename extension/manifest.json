{
  "manifest_version": 3,
  "name": "GPT 用量悬浮球 · 页面同步",
  "version": "2.7.0",
  "minimum_chrome_version": "114",
  "description": "同步官方用量页可见数字到本机悬浮球，可选定时后台读取；登录凭据仅由浏览器与官方网站管理。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "同步官方用量页到悬浮球"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:43861; img-src 'self'; style-src 'self'; base-uri 'none'; frame-src 'none'; form-action 'none'"
  },
  "optional_host_permissions": [
    "https://chatgpt.com/*"
  ]
}
