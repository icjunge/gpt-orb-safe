{
  "name": "gpt-usage-orb-safe",
  "productName": "GPT Usage Orb Safe",
  "version": "2.5.3",
  "description": "A local desktop usage orb with read-only official Codex CLI integration and optional browser-page sync.",
  "main": "src/main.cjs",
  "author": "GPT Usage Orb contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "release:sign": "node scripts/sign-release.cjs",
    "release:configure": "node scripts/configure-release.cjs",
    "release:key": "node scripts/generate-signing-key.cjs",
    "repository:setup": "node scripts/setup-repository.cjs",
    "release:setup": "node scripts/setup-release.cjs",
    "extension:update": "node scripts/update-extension.cjs"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
